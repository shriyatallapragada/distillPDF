{
  "manifest_version": 3,
  "name": "DistillPDF — NotebookLM PDF exporter",
  "short_name": "DistillPDF",
  "version": "0.2.0",
  "description": "Pick NotebookLM answers and build study-notes.pdf and study-notes.html locally. Zero network calls.",
  "key": "",
  "permissions": ["activeTab", "storage", "tabs", "scripting", "nativeMessaging"],
  "host_permissions": ["https://notebooklm.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pick answers and build PDF + HTML",
    "default_icon": {
      "16": "icons/cup16.png",
      "32": "icons/cup32.png",
      "48": "icons/cup48.png",
      "128": "icons/cup128.png"
    }
  },
  "icons": {
    "16": "icons/cup16.png",
    "32": "icons/cup32.png",
    "48": "icons/cup48.png",
    "128": "icons/cup128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://notebooklm.google.com/*"],
      "js": ["selectors.js", "converter.js", "content.js"],
      "css": ["palette.css", "content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["selectors.json"],
      "matches": ["https://notebooklm.google.com/*"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
